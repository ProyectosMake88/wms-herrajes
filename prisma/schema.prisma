generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// CATEGORÍAS - Relación uno a muchos con Productos
// ============================================================
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

// ============================================================
// PRODUCTOS - Modelo principal de inventario para herrajes
// ============================================================
model Product {
  id               Int            @id @default(autoincrement())
  name             String
  description      String?
  sku              String         @unique
  barcode          String?        @unique
  categoryId       Int            @map("category_id")
  unitOfMeasure    UnitOfMeasure  @map("unit_of_measure")
  currentStock     Int            @default(0) @map("current_stock")
  minimumStock     Int            @default(100) @map("minimum_stock")
  isLowStock       Boolean        @default(false) @map("is_low_stock")
  imageUrl         String?        @map("image_url") // Ruta de la imagen del producto
  warehouseLocation String?       @map("warehouse_location") // Ej: "Pasillo A, Estante 3"
  price            Decimal?       @db.Decimal(12, 2)
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  category   Category    @relation(fields: [categoryId], references: [id])
  movements  Movement[]

  @@index([categoryId])
  @@index([sku])
  @@index([isLowStock])
  @@map("products")
}

// ============================================================
// MOVIMIENTOS - Log de Entradas y Salidas de inventario
// ============================================================
model Movement {
  id          Int          @id @default(autoincrement())
  productId   Int          @map("product_id")
  type        MovementType
  quantity    Int
  reason      String
  responsible String       // Usuario responsable del movimiento
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("movements")
}

// ============================================================
// ENUMS
// ============================================================
enum MovementType {
  ENTRY  // Entrada de inventario
  EXIT   // Salida de inventario
}

enum UnitOfMeasure {
  UNIT     // Unidad
  DOZEN    // Docena
  THOUSAND // Millar
  KG       // Kilogramo
  METER    // Metro
  BOX      // Caja
  PAIR     // Par
}
