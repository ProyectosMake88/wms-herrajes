generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ORGANIZACIONES - Multi-empresa (cada cliente es una org)
// ============================================================
model Organization {
  id          Int      @id @default(autoincrement())
  name        String
  nit         String?  @unique // NIT o Tax ID
  logoUrl     String?  @map("logo_url")
  email       String?
  phone       String?
  address     String?
  website     String?
  planType    String   @default("basic") @map("plan_type") // basic, pro, enterprise
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users         User[]
  branches      Branch[]
  categories    Category[]
  products      Product[]
  movements     Movement[]
  notifications Notification[]
  pendingEntries PendingEntry[]

  @@map("organizations")
}

// ============================================================
// EMPRESA - Perfil de la empresa (singleton, solo 1 registro)
// ============================================================
model Company {
  id        Int      @id @default(1)
  name      String   @default("Mi Empresa")
  nit       String?
  address   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company")
}

// ============================================================
// SEDES - Sucursales con inventario independiente
// ============================================================
model Branch {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  name           String
  code           String   @unique
  address        String?
  city           String?
  phone          String?
  manager        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  users        User[]
  products     Product[]
  movements    Movement[]
  branchStocks BranchStock[]

  @@index([organizationId])
  @@map("branches")
}

// ============================================================
// STOCK POR SEDE - Cantidad de cada producto en cada sede
// ============================================================
model BranchStock {
  id        Int @id @default(autoincrement())
  branchId  Int @map("branch_id")
  productId Int @map("product_id")
  quantity  Int @default(0)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_stocks")
}

// ============================================================
// USUARIOS - Gestión de acceso con roles
// ============================================================
model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  name           String
  avatarUrl      String?  @map("avatar_url")
  role           UserRole @default(SELLER)
  organizationId Int?     @map("organization_id")
  branchId       Int?     @map("branch_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization?  @relation(fields: [organizationId], references: [id])
  branch           Branch?        @relation(fields: [branchId], references: [id])
  movements        Movement[]
  notifications    Notification[]
  pendingEntries   PendingEntry[] @relation("PendingEntryUser")
  reviewedEntries  PendingEntry[] @relation("PendingEntryReviewer")

  @@index([organizationId])
  @@index([branchId])
  @@map("users")
}

// ============================================================
// CATEGORÍAS - Relación uno a muchos con Productos
// ============================================================
model Category {
  id             Int       @id @default(autoincrement())
  organizationId Int?      @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@index([organizationId])
  @@map("categories")
}

// ============================================================
// PRODUCTOS - Modelo principal de inventario para herrajes
// ============================================================
model Product {
  id               Int            @id @default(autoincrement())
  organizationId   Int?           @map("organization_id")
  name             String
  description      String?
  sku              String         @unique
  barcode          String?        @unique
  categoryId       Int            @map("category_id")
  branchId         Int?           @map("branch_id")
  unitOfMeasure    UnitOfMeasure  @map("unit_of_measure")
  currentStock     Int            @default(0) @map("current_stock")
  minimumStock     Int            @default(100) @map("minimum_stock")
  isLowStock       Boolean        @default(false) @map("is_low_stock")
  imageUrl         String?        @map("image_url")
  warehouseLocation String?       @map("warehouse_location")
  cost             Decimal?       @db.Decimal(12, 2)
  price            Decimal?       @db.Decimal(12, 2)
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  organization   Organization?  @relation(fields: [organizationId], references: [id])
  category       Category       @relation(fields: [categoryId], references: [id])
  branch         Branch?        @relation(fields: [branchId], references: [id])
  movements      Movement[]
  notifications  Notification[]
  pendingEntries PendingEntry[]
  branchStocks   BranchStock[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([branchId])
  @@index([sku])
  @@index([isLowStock])
  @@map("products")
}

// ============================================================
// MOVIMIENTOS - Log de Entradas y Salidas de inventario
// ============================================================
model Movement {
  id             Int          @id @default(autoincrement())
  organizationId Int?         @map("organization_id")
  productId      Int          @map("product_id")
  userId         Int?         @map("user_id")
  branchId       Int?         @map("branch_id")
  type           MovementType
  quantity       Int
  salePrice      Decimal?     @map("sale_price") @db.Decimal(12, 2)
  saleTotal      Decimal?     @map("sale_total") @db.Decimal(12, 2)
  reason         String
  responsible    String
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([userId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@map("movements")
}

// ============================================================
// SOLICITUDES DE ENTRADA - Requieren aprobación del admin
// ============================================================
model PendingEntry {
  id             Int               @id @default(autoincrement())
  organizationId Int?              @map("organization_id")
  productId      Int               @map("product_id")
  userId         Int               @map("user_id")
  quantity       Int
  reason         String
  notes          String?
  status         PendingStatus     @default(PENDING)
  reviewedBy     Int?              @map("reviewed_by")
  reviewedAt     DateTime?         @map("reviewed_at")
  rejectReason   String?           @map("reject_reason")
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  user         User          @relation("PendingEntryUser", fields: [userId], references: [id])
  reviewer     User?         @relation("PendingEntryReviewer", fields: [reviewedBy], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("pending_entries")
}

// ============================================================
// NOTIFICACIONES - Alertas de stock y registro de ventas
// ============================================================
model Notification {
  id             Int              @id @default(autoincrement())
  organizationId Int?             @map("organization_id")
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false) @map("is_read")
  productId      Int?             @map("product_id")
  userId         Int?             @map("user_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// ENUMS
// ============================================================
enum PendingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  SALE
  ENTRY
  PENDING_ENTRY
  ENTRY_APPROVED
  ENTRY_REJECTED
}

enum UserRole {
  SUPER_ADMIN // Dueño de la plataforma - crea organizaciones
  ADMIN       // Administrador de organización - acceso total dentro de su org
  SELLER      // Vendedor - solo registrar salidas
}

enum MovementType {
  ENTRY
  EXIT
}

enum UnitOfMeasure {
  UNIT
  DOZEN
  THOUSAND
  KG
  METER
  BOX
  PAIR
}
