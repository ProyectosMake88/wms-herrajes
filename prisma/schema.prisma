generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// EMPRESA - Perfil de la empresa (singleton, solo 1 registro)
// ============================================================
model Company {
  id        Int      @id @default(1)
  name      String   @default("Mi Empresa")
  nit       String?  // NIT o identificación fiscal
  address   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company")
}

// ============================================================
// USUARIOS - Gestión de acceso con roles
// ============================================================
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(SELLER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements        Movement[]
  notifications    Notification[]
  pendingEntries   PendingEntry[] @relation("PendingEntryUser")
  reviewedEntries  PendingEntry[] @relation("PendingEntryReviewer")

  @@map("users")
}

// ============================================================
// CATEGORÍAS - Relación uno a muchos con Productos
// ============================================================
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

// ============================================================
// PRODUCTOS - Modelo principal de inventario para herrajes
// ============================================================
model Product {
  id               Int            @id @default(autoincrement())
  name             String
  description      String?
  sku              String         @unique
  barcode          String?        @unique
  categoryId       Int            @map("category_id")
  unitOfMeasure    UnitOfMeasure  @map("unit_of_measure")
  currentStock     Int            @default(0) @map("current_stock")
  minimumStock     Int            @default(100) @map("minimum_stock")
  isLowStock       Boolean        @default(false) @map("is_low_stock")
  imageUrl         String?        @map("image_url") // Ruta de la imagen del producto
  warehouseLocation String?       @map("warehouse_location") // Ej: "Pasillo A, Estante 3"
  cost             Decimal?       @db.Decimal(12, 2) // Costo de adquisición (solo visible para admin)
  price            Decimal?       @db.Decimal(12, 2) // Precio de venta
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  category       Category       @relation(fields: [categoryId], references: [id])
  movements      Movement[]
  notifications  Notification[]
  pendingEntries PendingEntry[]

  @@index([categoryId])
  @@index([sku])
  @@index([isLowStock])
  @@map("products")
}

// ============================================================
// MOVIMIENTOS - Log de Entradas y Salidas de inventario
// ============================================================
model Movement {
  id          Int          @id @default(autoincrement())
  productId   Int          @map("product_id")
  userId      Int?         @map("user_id")
  type        MovementType
  quantity    Int
  salePrice   Decimal?     @map("sale_price") @db.Decimal(12, 2) // Valor unitario de venta (solo EXIT)
  saleTotal   Decimal?     @map("sale_total") @db.Decimal(12, 2) // Total de la venta (precio x cantidad)
  reason      String
  responsible String       // Nombre del usuario responsable
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("movements")
}

// ============================================================
// SOLICITUDES DE ENTRADA - Requieren aprobación del admin
// ============================================================
model PendingEntry {
  id          Int               @id @default(autoincrement())
  productId   Int               @map("product_id")
  userId      Int               @map("user_id")
  quantity    Int
  reason      String
  notes       String?
  status      PendingStatus     @default(PENDING)
  reviewedBy  Int?              @map("reviewed_by")
  reviewedAt  DateTime?         @map("reviewed_at")
  rejectReason String?          @map("reject_reason")
  createdAt   DateTime          @default(now()) @map("created_at")

  product  Product @relation(fields: [productId], references: [id])
  user     User    @relation("PendingEntryUser", fields: [userId], references: [id])
  reviewer User?   @relation("PendingEntryReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("pending_entries")
}

// ============================================================
// NOTIFICACIONES - Alertas de stock y registro de ventas
// ============================================================
model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  productId Int?             @map("product_id")
  userId    Int?             @map("user_id") // Usuario que generó la acción
  createdAt DateTime         @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// ENUMS
// ============================================================
enum PendingStatus {
  PENDING   // Pendiente de aprobación
  APPROVED  // Aprobada
  REJECTED  // Rechazada
}

enum NotificationType {
  LOW_STOCK      // Alerta de stock bajo
  OUT_OF_STOCK   // Producto agotado
  SALE           // Venta registrada por vendedor
  ENTRY          // Entrada de inventario
  PENDING_ENTRY  // Solicitud de entrada pendiente de aprobación
  ENTRY_APPROVED // Entrada aprobada
  ENTRY_REJECTED // Entrada rechazada
}

enum UserRole {
  ADMIN   // Administrador - acceso total
  SELLER  // Vendedor - solo registrar salidas
}

enum MovementType {
  ENTRY  // Entrada de inventario
  EXIT   // Salida de inventario
}

enum UnitOfMeasure {
  UNIT     // Unidad
  DOZEN    // Docena
  THOUSAND // Millar
  KG       // Kilogramo
  METER    // Metro
  BOX      // Caja
  PAIR     // Par
}
